{
  "manifest_version": 3,
  "name": "Tab Transfer",
  "version": "1.0",
  "description": "Save and sync your open tabs.",
  "permissions": ["tabs", "storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["home.html", "signup.html"], 
      "matches": ["<all_urls>"]
    }
  ]
}

